{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(./gradlew *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git ls-files*)",
      "Bash(git remote -v)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh project item-list*)",
      "Bash(git checkout*)",
      "Bash(git rebase*)",
      "Bash(git push origin*)",
      "Bash(git push -u origin*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue create*)",
      "Bash(gh project item-add*)",
      "Bash(gh project item-edit*)",
      "Bash(gh label list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(adb devices)",
      "Bash(adb logcat *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/bootstrap.sh\" --hook 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking context files..."
          }
        ]
      }
    ]
  }
}
