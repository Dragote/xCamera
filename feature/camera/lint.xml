<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        ui/CameraScreen.kt's TextureView.SurfaceTextureListener wraps the TextureView's
        SurfaceTexture in a Surface once (in onSurfaceTextureAvailable) and releases that same
        Surface once (in onSurfaceTextureDestroyed, via Surface.release()) — but lint's Recycle
        check only does intraprocedural analysis within a single method/lambda, so it can't see that
        the release happens in a *different* callback against the shared `previewSurface` Compose
        state var the constructor's result is stored in. This is a documented false positive for
        this specific field-lifetime-spans-callbacks pattern, not a real leak.
    -->
    <issue id="Recycle">
        <ignore path="src/main/java/com/dragote/xcamera/feature/camera/ui/CameraScreen.kt" />
    </issue>
</lint>
